# Copy to .env and fill in for real (non-mock) runs.

# Required for real Gemini calls. Leave unset to run in MOCK_MODE.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Gemma model used for pre-firewall prompt-injection triage (firewall/gemma_triage.py).
# Served through the same GEMINI_API_KEY. Leave unset to use the default below,
# or MOCK_MODE's deterministic pattern-matching fallback.
GEMMA_MODEL=gemma-3-27b-it

# Required when BUS_BACKEND=pubsub or CHAIN_BACKEND=firestore
GOOGLE_CLOUD_PROJECT=

# local | pubsub  (local = in-process calls, no GCP needed)
BUS_BACKEND=local

# local | firestore  (local = JSON-lines file, no GCP needed)
CHAIN_BACKEND=local

# HMAC secret used to sign provenance records -- set a real random value
# before deploying; the default is dev-only and publicly known.
PROVENANCE_SIGNING_SECRET=dev-only-secret-change-me
